# --- Greeneek secrets contract -----------------------------------------------
# Copy to .env and fill. Never commit .env. All env reads are centralised in
# packages/base/src/settings.ts — do not read process.env elsewhere for Greeneek keys.

# --- Core --------------------------------------------------------------------
# Server port (CLI --port wins over env, defaults to 3080)
PORT=3080
POSTGRES_PASSWORD=change-me

# Model provider: echo | openai | anthropic | ollama | openrouter
GREENEK_MODEL_PROVIDER=echo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OPENROUTER_API_KEY=
# Gateway/API signing secret (generate with: openssl rand -hex 32)
GREENEK_GATEWAY_SECRET=generate-a-long-random-string
# Auto-approve shell tools without prompt (CI only — never in production)
GREENEK_AUTO_APPROVE=0

# --- Web search --------------------------------------------------------------
# Provider: mock | exa | perplexity | deepseek
WEB_SEARCH_PROVIDER=mock
EXA_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# --- Telemetry / observability -----------------------------------------------
# OTLP/JSONL export path for spans and cost ledger (optional)
GREENEK_OTEL_EXPORT_PATH=/data/otel.jsonl
# Verbose console sink (1 = debug, 0 = info-only)
GREENEK_VERBOSE=0

# --- Billing (Stripe; optional) ----------------------------------------------
STRIPE_WEBHOOK_SECRET=
# Plan tier: free | pro | team | enterprise
GREENEK_PLAN=free

# --- Marketplace -------------------------------------------------------------
# Curated registry URL (optional, empty = demo registry)
GREENEK_MARKETPLACE_URL=
