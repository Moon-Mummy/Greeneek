# --- Greeneek secrets contract -----------------------------------------------
# Copy to .env and fill. Never commit .env.
POSTGRES_PASSWORD=change-me

# Model provider: echo | openai | anthropic | ollama
GREENEK_MODEL_PROVIDER=echo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
# GREENEK_GATEWAY_SECRET=generate-a-long-random-string

# Web search: mock | exa | perplexity | deepseek
WEB_SEARCH_PROVIDER=mock
EXA_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Telemetry / observability (OTLP/JSONL sink; optional)
GREENEK_OTEL_EXPORT_PATH=/data/otel.jsonl

# Billing (Stripe; optional)
STRIPE_WEBHOOK_SECRET=
GREENEK_PLAN=free

# Marketplace registry (optional curated JSON endpoint)
GREENEK_MARKETPLACE_URL=
