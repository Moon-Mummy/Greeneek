{
  "id": "greeneek.provider.openrouter",
  "name": "OpenRouter Provider",
  "version": "0.1.0",
  "description": "OpenRouter adapter — /auth/key validation, /models listing, streaming with usage and precise error mapping",
  "kinds": ["provider"],
  "permissions": ["network", "secrets"],
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": { "type": "string" },
      "baseUrl": { "type": "string", "default": "https://openrouter.ai/api/v1" },
      "enabled": { "type": "boolean", "default": false }
    }
  },
  "minAppVersion": "0.1.0"
}
